# Pegar en Environment de Dokploy y completar allí; nunca versionar valores reales.
# Obligatorios. POSTGRES_PASSWORD: aleatoria; no cambiarla tras inicializar el volumen.
POSTGRES_PASSWORD=
TEAM_ENTRYPOINT_TOKEN=
# Clave Fernet (32 bytes en base64 URL-safe).
CREDENTIALS_ENCRYPTION_KEY=
# Secreto aleatorio independiente de al menos 32 caracteres, estable entre despliegues.
DESTINATION_HMAC_KEY=
OPENROUTER_API_KEY=

# Langfuse Cloud: completar ambas claves para exportar telemetría.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# PostgreSQL/Redis, logins y DSN internos se preparan automáticamente.
# Modelos por rol, recursos, Jev deshabilitado y demás opciones usan defaults de Compose.

# Presupuesto desde recepción, incluyendo cola y conexión.
TASK_SECONDS=300
ACTION_CUTOFF_SECONDS=290
CLOSE_TARGET_SECONDS=295
DRAIN_SECONDS=288
