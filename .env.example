# Copiar a .env para el backend o .env.vnc para pruebas VNC. Valores reales sólo localmente.
VNC_BASE_URL=
VNC_WS_URL=
VNC_PASSWORD=
VNC_DESKTOP_TOKEN=
TEAM_ENTRYPOINT_TOKEN=

# Conexiones privadas; ORM y adaptadores nativos LangGraph tienen formatos propios.
DATABASE_URL=
LANGGRAPH_DATABASE_URI=
REDIS_URL=

# Único acceso de modelos: OpenRouter, incluido Jev.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-6.1-sol

# Demo: deshabilitado. Producción: activar tras filtrar la telemetría.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Langfuse: autoactivo al configurar ambas claves; sólo metadatos seguros.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development


# Backend: configurar fuera de Git; claves aleatorias privadas.
TEAM_ID=frontier
CREDENTIALS_ENCRYPTION_KEY=
DESTINATION_HMAC_KEY=
MODEL_REASONING_EFFORT=low
ARTIFACT_DIR=.private/artifacts
ALLOW_PRIVATE_DESKTOPS=false

# Dokploy: DSN por rol; configurar logins/grants antes del runtime.
POSTGRES_PASSWORD=
MIGRATION_DATABASE_URL=
BOOTSTRAP_LANGGRAPH_DATABASE_URI=
GRANTS_DATABASE_URL=
API_DATABASE_URL=
DISPATCHER_DATABASE_URL=
WORKER_DATABASE_URL=

# Jev por OpenRouter Decisions. Demo deshabilitado; activar sólo en un perfil probado.
JEV_ENABLED=false
JEV_TIMEOUT_SECONDS=3
JEV_MAX_CALLS=4

# Routing por rol conectado a Settings, factory y Compose.
# MODEL_NAME es compatibilidad legacy; las variables por rol gobiernan la factory.
# Decisions endpoint is relative to the OpenRouter origin, NOT /api/v1.
# Defaults follow decision-modelos-openrouter.md; benchmarks are pending.
MODEL_COORDINATOR=openai/gpt-6-luna
MODEL_OPERATOR=openai/gpt-6-luna
MODEL_VERIFIER=anthropic/claude-sonnet-5.5
MODEL_RECOVERY=openai/gpt-6.1-sol
MODEL_ANALYST=openai/gpt-6-luna
MODEL_JEV=typesafe/jev-1.13
OPENROUTER_JEV_ENDPOINT=/api/alpha/decisions
OPENROUTER_PROVIDER_SORT=latency
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_FALLBACKS=false
GRAPH_VERSION=context-v2
# JSON validado por rol: timeout_seconds, max_output_tokens, reasoning_effort.
# Ejemplo: {"operator":{"timeout_seconds":15,"max_output_tokens":4096,"reasoning_effort":"minimal"}}
# reasoning_effort sólo se permite para perfiles OpenAI validados; null lo omite.
MODEL_PROFILES={}
